EKA_APP_ENVIRONMENT=development
EKA_LOG_LEVEL=INFO
EKA_QDRANT_URL=http://127.0.0.1:6333
EKA_QDRANT_COLLECTION=enterprise_knowledge_chunks
EKA_QDRANT_TIMEOUT_SECONDS=120
EKA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EKA_EMBEDDING_DIMENSION=384
EKA_EMBEDDING_BATCH_SIZE=64
EKA_GEMINI_API_KEY=
EKA_GEMINI_MODEL=gemini-3.6-flash
EKA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
EKA_GEMINI_TIMEOUT_SECONDS=60
EKA_RAG_RETRIEVAL_CANDIDATES=12
EKA_RAG_CONTEXT_SOURCES=6
EKA_RAG_MAX_CHUNKS_PER_DOCUMENT=2
EKA_RAG_MAX_CONTEXT_CHARACTERS=18000
EKA_NLP_MODEL=fastino/gliner2-base-v1
EKA_NLP_BATCH_SIZE=8
EKA_NLP_CONFIDENCE_THRESHOLD=0.65
EKA_NLP_MAX_INPUT_CHARACTERS=1800
